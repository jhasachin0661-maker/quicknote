# QuickNote Backend Environment Variables
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Optional: Managed PostgreSQL / Supabase
# If left empty, a local SQLite database (quicknote.db) is automatically used.
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
# SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]

